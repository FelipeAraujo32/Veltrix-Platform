# ==============================================================================
# Veltrix Platform — compose.yml (raiz) — arquivo de exemplo.
# Copie para `.env` e preencha. NUNCA versione o `.env` real (já ignorado no git).
#
#   cp .env.example .env
#   docker compose --env-file .env up -d --build
#
# IMPORTANTE: NENHUM segredo mora neste arquivo (nem senha de banco, nem senha de
# admin, nem chave). Segredos ficam em arquivos dentro de `./secrets/` (dir
# gitignored) e entram nos containers pelo mecanismo `secrets:` do compose
# (montados em /run/secrets; o Spring, no perfil `prod`, importa /run/secrets
# como properties via configtree). Serviço sem secret obrigatório NÃO SOBE
# (fail-closed).
# ==============================================================================

# ------------------------------------------------------------------ SECRETS
# TRÊS arquivos. Crie-os ANTES do primeiro `docker compose up`. Conteúdo =
# valor do segredo, SEM aspas e SEM quebra de linha final (use printf, não echo).
#
# Bash (Git Bash/WSL/Linux):
#   mkdir -p secrets
#   # 1. Senha do login de aplicação `veltrix` no SQL Server (o bloco de
#   #    provisionamento no cabeçalho do compose.yml usa ESTA senha — gere antes):
#   printf '%s' "$(openssl rand -base64 32)" > secrets/auth_db_password
#   # 2. Chave privada JWT (PKCS#8) do auth-service — quem assina os tokens:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out secrets/jwt-private.pem
#   # 3. Senha do admin inicial — o arquivo precisa EXISTIR sempre; preencha só
#   #    na primeira subida e ESVAZIE depois do primeiro login (: > arquivo):
#   printf '%s' "$(openssl rand -base64 24)" > secrets/auth_bootstrap_password
#   # 4. PERMISSÃO: os containers Java rodam como usuário não-root ('veltrix').
#   #    O compose faz bind-mount do arquivo com as permissões do host; com 600
#   #    (root) o serviço morre em loop com AccessDeniedException em
#   #    /run/secrets/... — deixe legível:
#   chmod 644 secrets/auth_db_password secrets/jwt-private.pem secrets/auth_bootstrap_password
#
# Overrides opcionais de caminho (defaults: ./secrets/<nome>):
#AUTH_DB_PASSWORD_FILE=./secrets/auth_db_password
#AUTH_BOOTSTRAP_PASSWORD_FILE=./secrets/auth_bootstrap_password
# A senha do SA fica FORA desta stack: pertence só ao container externo
# `sqlserver` e não é montada em nenhum serviço da Veltrix.

# ------------------------------------------------------------------ SQL Server
# Banco único da plataforma; cada módulo usa um SCHEMA próprio (security,
# ouvidoria, ...). Criação: bloco de provisionamento no cabeçalho do compose.yml.
DB_NAME=veltrix_platform

# Login de aplicação (não é segredo; a senha vem do secret auth_db_password).
# Criado com privilégio mínimo no provisionamento — NUNCA use `sa`.
AUTH_DB_USERNAME=veltrix

# TLS do SQL Server (a URL JDBC usa encrypt=true sempre):
# - true  => aceita o certificado AUTOASSINADO do container mssql "stock".
#            Use em DEV/HOMOLOGAÇÃO e enquanto a VPS não tiver certificado válido
#            no `sqlserver` (o tráfego segue cifrado; só não valida a cadeia).
# - false => exige certificado válido montado no container mssql (alvo em prod).
# Default fail-closed: variável ausente => compose assume 'false'.
SQL_TRUST_SERVER_CERT=false

# ------------------------------------------------------------------ JWT (auth)
# Caminho no HOST para a chave privada JWT (PKCS#8) — ver seção SECRETS.
JWT_PRIVATE_KEY_HOST_PATH=./secrets/jwt-private.pem
JWT_KEY_ID=veltrix-2026-01
JWT_ISSUER=veltrix-auth
JWT_AUDIENCE=veltrix-platform
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ------------------------------------------------------------------ auth-service
# 'true' exige HTTPS nos cookies (padrão de produção). Use 'false' só em dev sem TLS.
AUTH_COOKIE_SECURE=true
# Origens que o navegador usa para chegar à plataforma (CORS). Produção:
AUTH_ALLOWED_ORIGINS=https://veltrixbr.com.br,https://www.veltrixbr.com.br
# AUTH_TRUSTED_PROXIES: peers confiáveis (IP/CIDR) cujo IP de cliente é honrado.
# Em produção estreite para a SUBNET DOCKER DO NPM (Nginx Proxy Manager) — é ele
# quem fala com a stack. Descubra com:
#   docker network inspect veltrix-platform_veltrix --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#   (e/ou a rede onde o NPM vive: docker network inspect <rede-do-npm>)
# Sem estreitar, o lockout conta+IP degrada para conta+constante = DoS de conta barato.
AUTH_TRUSTED_PROXIES=172.18.0.0/16
# Timeouts do Redis: curtos de propósito (Redis lento vira fail-open, não trava o login).
AUTH_REDIS_TIMEOUT=300ms
AUTH_REDIS_CONNECT_TIMEOUT=500ms
# Lockout: conta+IP (progressivo) e conta sozinha (limiar alto, bloqueio curto fixo).
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_BASE_BLOCK=1m
AUTH_LOCKOUT_MAX_BLOCK=15m
AUTH_LOCKOUT_FAIL_WINDOW=15m
AUTH_LOCKOUT_ACCOUNT_MAX_ATTEMPTS=30
AUTH_LOCKOUT_ACCOUNT_BLOCK=5m
AUTH_LOCKOUT_ACCOUNT_FAIL_WINDOW=10m

# ------------------------------------------------------------------ bootstrap admin
# Cria o admin inicial UMA vez. A senha NÃO fica aqui: vai no arquivo
# secrets/auth_bootstrap_password (Docker secret). Primeira subida: preencha o
# arquivo, defina enabled=true e o email, e suba. Depois do primeiro login:
# enabled=false, esvazie o arquivo (: > secrets/auth_bootstrap_password) e
# recrie o auth-service. enabled=true com arquivo vazio derruba o boot
# (fail-closed, mensagem do AdminBootstrap).
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_NAME=Administrador

# ------------------------------------------------------------------ api-gateway
CORS_ALLOWED_ORIGINS=https://veltrixbr.com.br,https://www.veltrixbr.com.br
# HSTS na borda (TLS termina no edge externo). 'false' só p/ debug local em HTTP puro.
GATEWAY_HSTS_ENABLED=true
# Rate-limit no gateway (usa o Redis do compose). trusted-proxies em CIDR —
# mesma regra do AUTH_TRUSTED_PROXIES: estreite para a subnet Docker do NPM.
RATE_LIMIT_TRUSTED_PROXIES=172.18.0.0/16
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW=1m

# ------------------------------------------------------------------ frontend
# Base de API usada pelo NAVEGADOR (não o hostname interno do Docker).
# VAZIO = caminho relativo (same-origin): o NPM/nginx do portal roteia /api para
# o gateway — é o modo de produção. Em dev sem edge: http://localhost:8080
PORTAL_API_BASE_URL=
PORTAL_URL=https://veltrixbr.com.br
